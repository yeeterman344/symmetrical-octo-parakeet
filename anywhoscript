local function getHealthColor(healthPercent)
    if healthPercent > 0.7 then
        return Color3.new(0, 1, 0)
    elseif healthPercent > 0.3 then
        return Color3.new(1, 1, 0)
    else
        return Color3.new(1, 0, 0)
    end
end

